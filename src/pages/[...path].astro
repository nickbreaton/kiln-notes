---
import "../styles/global.css";
import { App } from "../components/App";

export const prerender = false;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&display=block"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta
      name="viewport"
      content="width=device-width, viewport-fit=cover, user-scalable=no"
    />
    <meta name="generator" content={Astro.generator} />
    <title>Kiln Notes</title>
  </head>
  <body class="relative select-none pointer-fine:select-auto font-sans">
    <App client:only="react" />
  </body>
</html>
